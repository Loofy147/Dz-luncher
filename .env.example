# Local development only. PostgreSQL is required when APP_ENV=production.
APP_ENV=development
DATABASE_URL=sqlite:///./.data/dz_luncher.db
# Replace before deployment. Generate each value independently with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
PSEUDONYM_SECRET=replace-with-a-different-random-secret-at-least-32-bytes-long

# Account verification / password recovery (production always requires email verification)
EMAIL_VERIFICATION_REQUIRED=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Local development uses console delivery. Never use console delivery in production.
AUTH_EMAIL_BACKEND=console
# Production: AUTH_EMAIL_BACKEND=smtp and configure these with a trusted mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
